---
// Email link, or a WhatsApp link that exists only once config.whatsapp is set. Nothing renders otherwise.
import { config } from "../config.js";
import { emailHref, waHref } from "../lib/contact.js";
import Val from "./Val.astro";
const { kind, label, class: cls } = Astro.props;
const href = kind === "email" ? emailHref() : waHref();
const text = label ?? (kind === "email" ? config.email : "WhatsApp");
---
{href ? (
  <a class={cls} href={href} {...(kind === "whatsapp" ? { rel: "noopener", target: "_blank" } : {})}>{text}</a>
) : kind === "email" ? (
  <span class={cls}><Val v={config.email} /></span>
) : null}
