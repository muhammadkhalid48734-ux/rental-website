---
import { config } from "../config.js";
import { convertHours, parseHHMM, studioOffset } from "../lib/hours.js";
import Val from "./Val.astro";
import ContactLink from "./ContactLink.astro";
import { waOk } from "../lib/contact.js";

const { start, end } = config.supportHours;
const zones = convertHours(config.timezone, start, end);
// A plain number goes to the browser, so the studio's zone name never appears in the page.
const offset = studioOffset(config.timezone);
---
<section class="section section--soft" id="about" aria-labelledby="about-title">
  <div class="wrap about">
    <div class="about__photo">
      {config.ownerPhoto ? (
        <img src={config.ownerPhoto} alt={`Photo of ${config.ownerName}`} width="150" height="150" loading="lazy" decoding="async" />
      ) : (
        <div class="photo-ph" role="img" aria-label="Owner photo goes here">
          <svg viewBox="0 0 120 120" width="120" height="120" aria-hidden="true" focusable="false"><circle cx="60" cy="46" r="22" fill="none" stroke="#55617a" stroke-width="3" /><path d="M20 108c4-24 20-34 40-34s36 10 40 34" fill="none" stroke="#55617a" stroke-width="3" stroke-linecap="round" /></svg>
          <span>Photo placeholder</span>
        </div>
      )}
    </div>
    <div class="about__text">
      <p class="eyebrow">Who&#39;s behind it</p>
      <h2 id="about-title">Who you are dealing with</h2>
      <p class="about__lead"><strong>A small remote studio.</strong> We work online.</p>
      <p class="about__name"><strong><Val v={config.ownerName} /></strong>, <Val v={config.ownerRole} /></p>
      <p><Val v={config.ownerBio} /></p>

      <p class="about__links">
        <ContactLink kind="email" class="btn btn--ghost" label="Email us" />
        {waOk() && <ContactLink kind="whatsapp" class="btn btn--ghost" label="Message on WhatsApp" />}
      </p>
    </div>
    <div class="hours" data-hours data-offset={offset} data-start={start} data-end={end}>
      <h3>Support hours</h3>
      <p class="hours__studio">{parseHHMM(start) && parseHHMM(end) ? config.supportHours.daysLabel : <Val v="TODO: supportHours" />}</p>
      {zones ? (
        <>
          <ul class="hours__list" data-hours-list>
            {zones.map((z) => (
              <li><span>{z.label}</span><span class="mono">{z.range} {z.abbr}</span></li>
            ))}
          </ul>
          <p class="hours__fine" data-hours-fine>Times shown for the day this page was built. Daylight saving can move them by an hour.</p>
        </>
      ) : (
        <p class="hours__fine">Times appear here once support hours are filled in.</p>
      )}
      <p class="hours__reply"><strong>Reply time:</strong> <Val v={config.replyTime} />. <strong>Demos:</strong> ready {config.demoTurnaround}.</p>
    </div>
  </div>
</section>
<script>
  import { convertHours } from "../lib/hours.js";
  const root = document.querySelector("[data-hours]");
  if (root) {
    const zones = convertHours(Number(root.dataset.offset), root.dataset.start, root.dataset.end);
    const list = root.querySelector("[data-hours-list]");
    if (zones && list) {
      list.replaceChildren(
        ...zones.map((z) => {
          const li = document.createElement("li");
          const a = document.createElement("span");
          a.textContent = z.label;
          const b = document.createElement("span");
          b.className = "mono";
          b.textContent = `${z.range} ${z.abbr}`;
          li.append(a, b);
          return li;
        })
      );
      const fine = root.querySelector("[data-hours-fine]");
      if (fine) fine.hidden = true;
    }
  }
</script>
