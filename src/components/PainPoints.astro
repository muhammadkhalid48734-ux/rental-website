---
import { config } from "../config.js";
import SetupNote from "./SetupNote.astro";
const [found, booked, paid] = config.packages;
const items = [
  {
    when: "10pm, a message",
    said: "“Is this available Saturday?”",
    fix: `Customers ask through your form and get an auto-reply at once. With ${booked.name} they see your open dates before they ask.`
  },
  {
    when: "Saturday morning",
    said: "“Wait. Did I already promise that one?”",
    fix: "When you confirm a booking, or its deposit arrives, that date is blocked for the next customer."
  },
  {
    when: "Friday night",
    said: "“They never confirmed. Or they forgot.”",
    fix: "Unbooked inquiries get follow-ups after 1, 3 and 7 days. Unpaid deposits get reminders, and customers get a reminder before the event."
  },
  {
    when: "After every party",
    said: "“Great parties, and almost no Google reviews.”",
    fix: "Every customer gets a review request after the event, with your Google link."
  }
];
---
<section class="section" id="familiar" aria-labelledby="familiar-title">
  <div class="wrap">
    <div class="section__head">
      <h2 id="familiar-title">Sound familiar?</h2>
      <p>Four things rental owners say. Each one has a fix.</p>
    </div>
    <ol class="pains">
      {items.map((p) => (
        <li class="pain">
          <p class="pain__when">{p.when}</p>
          <p class="pain__said">{p.said}</p>
          <p class="pain__fix"><span class="pain__fixlabel">The fix</span> {p.fix}</p>
        </li>
      ))}
    </ol>
    <p class="pains__note">Fixes 2 and 3 come with {booked.name} and {paid.name}. Fixes 1 and 4 start with {found.name}. All of it is <SetupNote lower /></p>
  </div>
</section>
