---
import { config } from "../config.js";
import Val from "./Val.astro";
import ContactLink from "./ContactLink.astro";
import { emailOk, waOk } from "../lib/contact.js";
---
<footer class="site-footer">
  <div class="wrap footer__grid">
    <div>
      <p class="footer__name"><Val v={config.studioName} /></p>
      <p class="footer__small">A small remote studio, working online.</p>
      <p><ContactLink kind="email" class="footer__link" /></p>
      {waOk() && <p><ContactLink kind="whatsapp" class="footer__link" label="Message on WhatsApp" /></p>}
    </div>
    <div>
      <p class="footer__small"><a href="/privacy/">Privacy</a> · <a href="/terms/">Terms</a></p>
      <p class="footer__small">Your free demo stays private and is never published without your OK.</p>
      <p class="footer__small">
        Don’t want messages from us? Email {emailOk() ? <ContactLink kind="email" class="footer__link" /> : <Val v={config.email} />} and we’ll stop.
      </p>
    </div>
  </div>
</footer>
