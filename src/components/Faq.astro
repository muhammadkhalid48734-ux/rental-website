---
import { buildFaq } from "../lib/faq.js";
const faq = buildFaq();
---
<section class="section" id="faq" aria-labelledby="faq-title">
  <div class="wrap faq">
    <div class="section__head">
      <p class="eyebrow">Questions</p>
      <h2 id="faq-title">Questions owners ask</h2>
      <p>Short, plain answers. If yours is not here, ask in the form below.</p>
    </div>
    <div class="faq__list">
      {faq.map((f) => (
        <details class="faq__item">
          <summary><span>{f.q}</span></summary>
          <p set:html={f.a} />
        </details>
      ))}
    </div>
  </div>
</section>
