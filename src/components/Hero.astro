---
import { config } from "../config.js";
import { fromLine } from "../lib/pricing.js";
import { termsFree, noDemo } from "../lib/terms.js";
import { heroHeadline } from "../lib/copy.js";
import PaintPour from "./PaintPour.astro";
import PhoneFrame from "./PhoneFrame.astro";
import MiniSite from "./MiniSite.astro";
---
<section class="hero" aria-labelledby="hero-title">
  <div class="wrap hero__grid">
    <div class="hero__copy">
      <h1 id="hero-title">{heroHeadline}</h1>
      <p class="hero__lead">{fromLine()}</p>
      <div class="hero__actions">
        <a class="btn btn--primary" href="#demo" data-scroll-form>Get my free demo</a>
        <a class="link-strong" href="#samples">See sample sites</a>
      </div>
      <p class="hero__fine"><strong>Free private demo. {termsFree()}</strong></p>
      <p class="hero__fine hero__fine--2">{noDemo()} Your demo is ready {config.demoTurnaround}, after you send your page.</p>
    </div>
    <div class="hero__visual">
      <PaintPour />
      <PhoneFrame class="hero__phone"><MiniSite /></PhoneFrame>
    </div>
  </div>
</section>
