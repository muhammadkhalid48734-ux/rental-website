---
// Original inflatable illustrations (no characters, no logos). Colours come from CSS variables:
// --i-a (main body), --i-b (towers / slide), --i-c (trim), --i-d (outline).
const { kind = "castle", label = "" } = Astro.props;
---
<svg viewBox="0 0 160 120" width="160" height="120" role={label ? "img" : undefined} aria-label={label || undefined} aria-hidden={label ? undefined : "true"} focusable="false" class="inflatable">
  <g stroke="var(--i-d, #0f1a33)" stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round">
    <ellipse cx="80" cy="113" rx="70" ry="4" fill="rgba(15,26,51,.10)" stroke="none" />
    {kind === "castle" && (<>
      <rect x="28" y="52" width="104" height="58" rx="8" fill="var(--i-a, #2447d6)" />
      <rect x="14" y="30" width="38" height="80" rx="10" fill="var(--i-b, #ffc83d)" />
      <rect x="108" y="30" width="38" height="80" rx="10" fill="var(--i-b, #ffc83d)" />
      <circle cx="33" cy="24" r="9" fill="var(--i-c, #fff)" />
      <circle cx="127" cy="24" r="9" fill="var(--i-c, #fff)" />
      <circle cx="80" cy="46" r="8" fill="var(--i-c, #fff)" />
      <path d="M62 110V84a18 18 0 0 1 36 0v26z" fill="#fff" />
      <circle cx="33" cy="58" r="6" fill="#fff" /><circle cx="127" cy="58" r="6" fill="#fff" />
    </>)}
    {kind === "slide" && (<>
      <rect x="12" y="38" width="52" height="72" rx="10" fill="var(--i-a, #2447d6)" />
      <circle cx="38" cy="30" r="9" fill="var(--i-c, #fff)" />
      <path d="M64 50L148 108H64z" fill="var(--i-b, #ffc83d)" />
      <path d="M64 50L148 108" fill="none" />
      <path d="M26 110v-22h24v22" fill="#fff" />
      <path d="M26 98h24M26 104h24" fill="none" stroke-width="2" />
    </>)}
    {kind === "obstacle" && (<>
      <rect x="10" y="62" width="140" height="48" rx="8" fill="var(--i-a, #2447d6)" />
      <path d="M26 110V86a14 14 0 0 1 28 0v24zM66 110V86a14 14 0 0 1 28 0v24zM106 110V86a14 14 0 0 1 28 0v24z" fill="#fff" />
      <rect x="10" y="38" width="22" height="30" rx="8" fill="var(--i-b, #ffc83d)" />
      <rect x="69" y="38" width="22" height="30" rx="8" fill="var(--i-b, #ffc83d)" />
      <rect x="128" y="38" width="22" height="30" rx="8" fill="var(--i-b, #ffc83d)" />
      <circle cx="21" cy="32" r="6" fill="var(--i-c, #fff)" /><circle cx="80" cy="32" r="6" fill="var(--i-c, #fff)" /><circle cx="139" cy="32" r="6" fill="var(--i-c, #fff)" />
    </>)}
    {kind === "combo" && (<>
      <rect x="10" y="50" width="70" height="60" rx="8" fill="var(--i-a, #2447d6)" />
      <rect x="6" y="28" width="30" height="82" rx="9" fill="var(--i-b, #ffc83d)" />
      <rect x="54" y="28" width="30" height="82" rx="9" fill="var(--i-b, #ffc83d)" />
      <circle cx="21" cy="22" r="8" fill="var(--i-c, #fff)" /><circle cx="69" cy="22" r="8" fill="var(--i-c, #fff)" />
      <path d="M84 56L152 108H84z" fill="var(--i-c, #fff)" />
      <path d="M36 110V92a9 9 0 0 1 18 0v18z" fill="#fff" />
    </>)}
    {kind === "dome" && (<>
      <path d="M16 110a64 64 0 0 1 128 0z" fill="var(--i-a, #2447d6)" />
      <circle cx="56" cy="78" r="9" fill="var(--i-c, #fff)" /><circle cx="96" cy="68" r="9" fill="var(--i-b, #ffc83d)" />
      <circle cx="116" cy="94" r="7" fill="var(--i-c, #fff)" /><circle cx="40" cy="98" r="6" fill="var(--i-b, #ffc83d)" />
      <path d="M68 110V96a12 12 0 0 1 24 0v14z" fill="#fff" />
    </>)}
  </g>
</svg>
