---
import { config } from "../config.js";
import { planPrice, editsText, newFeatures, hasAfterSignup } from "../lib/pricing.js";
import { termsFull } from "../lib/terms.js";
import Check from "./Check.astro";
import Legend from "./Legend.astro";
import CompareTable from "./CompareTable.astro";
import Addons from "./Addons.astro";
---
<section class="section section--soft" id="packages" aria-labelledby="packages-title">
  <div class="wrap">
    <div class="section__head">
      <p class="eyebrow">Plans and pricing</p>
      <h2 id="packages-title">Pick what you need</h2>
      <p>Website build is free. You pay only the monthly plan.</p>
    </div>

    <div class="plans__terms">
      <p><strong>{termsFull()}</strong></p>
      {hasAfterSignup() && (
        <p class="plans__setup">Nothing below is running for you today. Features with a clock icon are set up after you sign up.</p>
      )}
      <Legend />
    </div>

    <ul class="plans">
      {config.packages.map((p, i) => {
        const price = planPrice(p);
        return (
          <li class:list={["plan", p.recommended && "plan--rec"]}>
            {p.recommended && <span class="tag tag--rec plan__flag">Recommended</span>}
            <h3>{p.name}</h3>
            <p class="plan__tagline">{p.tagline}</p>
            <p class="plan__price">
              <span class="plan__setup mono">{price.main}</span>
              <span class="plan__monthly">/month</span>
            </p>
            <p class="plan__first">
              <span class="plan__firstlabel">Website build</span>
              <span class="plan__firstmath">Free</span>
              <span class="plan__firstnote">You pay only the monthly plan.</span>
            </p>
            <ul class="plan__features">
              {i > 0 && <li class="plan__everything">Everything in {config.packages[i - 1].name}, plus:</li>}
              {newFeatures(i).map((f) => (
                <li>
                  <Check kind={f.status === "ready" ? "yes" : "setup"} />
                  <span>
                    {f.text}
                    {f.status === "after-signup" && <span class="sr-only">. Set up after you sign up.</span>}
                    {f.sms && !config.smsAvailable && <> <span class="tag tag--soon">Coming soon</span></>}
                  </span>
                </li>
              ))}
              <li><Check kind="yes" /><span>{editsText(p)}</span></li>
            </ul>
            {newFeatures(i).some((f) => f.sms) && !config.smsAvailable && (
              <p class="plan__note">Text reminders are coming soon. Until then, reminders go by email.</p>
            )}
            <a class:list={["btn", "btn--block", p.recommended ? "btn--sun" : "btn--ghost"]} href="#demo" data-scroll-form>Get my free demo</a>
          </li>
        );
      })}
    </ul>
    <p class="plans__fine">If you don't like the demo you pay nothing.</p>

    <CompareTable />
    <Addons />
  </div>
</section>
